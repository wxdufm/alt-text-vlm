# Postgres connection string. Used by server.js, alt_text_server.js, and the
# scripts/ data pipeline (generate-testdata.js, export_data.js).
PG_URI=postgresql://localhost/your_db_name

# Discogs personal access token. Used by scripts/generate-testdata.js (cover
# art fallback) and the id-matching scripts under discogs_review_tmp/.
# Not needed for fine-tuning or generation.
DISCOGS_TOKEN=

# Port for server.js, the human review tool (public/review_website).
PORT=3000

# Base URL for WXDU's internal releases API. Only relevant if you have
# access to that system; irrelevant for fine-tuning/generation on the
# public dataset.
NEXT_PUBLIC_API_URL=https://api.wxdu.art

# --- Optional, all have working defaults if unset ---

# Port for alt_text_server.js, the generation playground
# (public/alt_text_generation_website). Defaults to 3001.
# ALT_TEXT_PORT=3001

# Host both servers bind to. Defaults to 0.0.0.0.
# HOST=0.0.0.0

# Python interpreter alt_text_server.js spawns scripts/inference_server.py
# with. Defaults to /Users/xdu/miniconda3/bin/python3 -- almost certainly
# needs overriding to match your own Python/conda environment.
# PYTHON_BIN=/path/to/your/python3

# Port scripts/inference_server.py listens on, and that alt_text_server.js
# talks to it over. Defaults to 8765.
# INFERENCE_PORT=8765
